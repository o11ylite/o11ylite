#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools make java clojure

echo "--- :mirror: Configuring Maven, Clojar mirror (content-cache)"
mkdir -p "$HOME/.m2"
cp .buildkite/maven-settings.xml "$HOME/.m2/settings.xml"

cd backend

echo "--- :package: Fetching dependencies"
make deps
make otel-proto-download
make proto-compile

echo "--- :clojure: Running tests"
make test
