# O11yLite Production Caddyfile
#
# Serves as reverse proxy for the backend and static file server for frontend assets.
# No TLS - designed to run behind a load balancer or ingress controller.

{
	# Disable admin API in production
	admin off
	# No automatic HTTPS
	auto_https off
	# Enable HTTP/2 cleartext (h2c) for OTel Collector compatibility
	servers :80 {
		protocols h1 h2c
	}
}

:80 {
	encode zstd gzip

	# Serve frontend static assets directly from filesystem
	handle /frontend/* {
		root * /app
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# gRPC OTLP services - proxy to grpc-java server
	# Matches paths like /opentelemetry.proto.collector.trace.v1.TraceService/Export
	@grpc path /opentelemetry.proto.collector.*
	handle @grpc {
		reverse_proxy h2c://127.0.0.1:{$O11YLITE_OTEL_GRPC_PORT:4317}
	}

	# All other requests go to the Clojure backend (Inertia pages, API)
	handle {
		reverse_proxy 127.0.0.1:{$O11YLITE_WEB_PORT:3000}
	}
}
