{;; ---------------------------------------------------------
 :paths
 ["src" "resources" "classes"]
 ;; ---------------------------------------------------------

 ;; ---------------------------------------------------------
 :deps
 {;; Application
  org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/core.async {:mvn/version "1.9.865"}
  org.clojure/core.memoize {:mvn/version "1.2.281"}
  com.brunobonacci/mulog {:mvn/version "0.10.1"}
  com.brunobonacci/mulog-adv-console {:mvn/version "0.10.1"}
  com.brunobonacci/mulog-opentelemetry {:mvn/version "0.10.1"}

  ;; System
  integrant/integrant {:mvn/version "1.0.1"}
  aero/aero {:mvn/version "1.1.6"}

  ;; HTTP Server
  ring/ring-core {:mvn/version "1.15.5"}
  ring/ring-jetty-adapter {:mvn/version "1.15.5"}
  ring/ring-defaults {:mvn/version "0.7.1"}

  ;; Http Client
  org.babashka/http-client {:mvn/version "0.4.24"}

  ;; Routing
  metosin/reitit-ring {:mvn/version "0.10.1"}
  metosin/reitit-middleware {:mvn/version "0.10.1"}

  ;; JSON
  metosin/jsonista {:mvn/version "1.0.0"}

  ;; Inertia
  hiccup/hiccup {:mvn/version "2.0.0"}

  ;; gRPC
  io.grpc/grpc-netty-shaded {:mvn/version "1.83.1"}
  io.grpc/grpc-protobuf {:mvn/version "1.83.1"}
  io.grpc/grpc-stub {:mvn/version "1.83.1"}

  ;; Protobuf - version must match vendored protoc in Makefile
  ;; Update PROTOC_VERSION in Makefile when changing this version
  ;; protoc 34.x maps to protobuf-java 4.34.x (protoc X.Y = protobuf-java 4.X.Y)
  com.google.protobuf/protobuf-java {:mvn/version "4.35.1"}
  ;; Protobuf JSON support for OTLP HTTP
  com.google.protobuf/protobuf-java-util {:mvn/version "4.35.1"}

  ;; javax.annotation for generated gRPC code
  javax.annotation/javax.annotation-api {:mvn/version "1.3.2"}

  ;; DuckDB
  org.duckdb/duckdb_jdbc {:mvn/version "1.5.5.1"}

  ;; SQLite
  org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}

  ;; Connection pooling & JDBC
  com.zaxxer/HikariCP {:mvn/version "7.1.0"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}

  ;; Migrations
  migratus/migratus {:mvn/version "1.6.7"}

  ;; Schema validation
  metosin/malli {:mvn/version "0.20.1"}

  ;; Serialization
  com.taoensso/nippy {:mvn/version "3.8.1"}

  ;; Utility for time
  tick/tick {:mvn/version "1.0.1"}

  ;; UUID v7 generation
  com.github.f4b6a3/uuid-creator {:mvn/version "6.1.1"}

  ;; OpenTelemetry manual instrumentation
  com.github.steffan-westcott/clj-otel-api {:mvn/version "0.2.10"}

  ;; OIDC client for UI authentication
  io.github.zhming0/oidc-client {:mvn/version "2026.3.3-1124840"}

  ;; JWT signing/verification for OAuth agent auth
  com.auth0/java-jwt {:mvn/version "4.6.0"}}
 ;; ---------------------------------------------------------

 ;; ---------------------------------------------------------
 :aliases
 {;; ------------
  ;; Run in development mode (uses Vite dev server)
  ;; Sets O11YLITE_DEV env var to enable dev profile
  :run/dev
  {:main-opts ["-m" "o11ylite.backend"]}

  ;; ------------
  ;; Add libraries and paths to support additional test tools
  :test/env
  {}

  ;; Test runner - local and CI
  ;; call with :watch? true to start file watcher and re-run tests on saved changes
  :test/run
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner"]
   :exec-fn kaocha.runner/exec-fn
   :exec-args {:randomize? false
               :fail-fast? true}}
  ;; ------------

  ;; ------------
  ;; tools.build `build.clj` built script
  :build/task
  {:replace-paths ["."]
   :replace-deps  {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
   :ns-default    build}

  ;; ------------
  ;; OpenTelemetry automatic instrumentation via javaagent
  ;; Endpoint configured via OTEL_EXPORTER_OTLP_ENDPOINT env var
  ;; (set by dev/start, defaults to http://localhost:4317)
  :otel
  {:jvm-opts ["-javaagent:.tmp/opentelemetry-javaagent.jar"
              "-Dotel.service.name=o11ylite"
              "-Dotel.exporter.otlp.protocol=grpc"]}

  ;; ------------
  ;; Development environment paths
  :dev/env
  {:extra-paths ["dev"]
   :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.1"}}}

  ;; ------------
  ;; REPL with reloaded workflow support
  :repl/reloaded
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl                  {:mvn/version "1.7.0"}
                cider/cider-nrepl            {:mvn/version "0.62.2"}
                djblue/portal                {:mvn/version "0.67.2"}   ; portal data inspector
                clj-commons/clj-yaml         {:mvn/version "1.0.29"}   ; portal yaml support (optional)
                org.clojure/tools.namespace  {:mvn/version "1.5.1"}
                org.clojure/tools.trace      {:mvn/version "0.9.0"}
                org.slf4j/slf4j-nop          {:mvn/version "2.0.18"}
                com.brunobonacci/mulog       {:mvn/version "0.10.1"}
                lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                org.clojure/test.check       {:mvn/version "1.1.3"}
                ring/ring-mock               {:mvn/version "0.6.2"}
                criterium/criterium          {:mvn/version "0.4.6"}}
   :main-opts  ["--eval" "(apply require clojure.main/repl-requires)"
                "--main" "nrepl.cmdline"
                "--middleware" "[cider.nrepl/cider-middleware,portal.nrepl/wrap-portal]"]}

  ;; ------------
  ;; Integrant REPL utilities for system lifecycle management
  :lib/integrant-repl
  {:extra-deps {integrant/repl {:mvn/version "0.5.1"}}}}}

;; ------------
;; ---------------------------------------------------------
