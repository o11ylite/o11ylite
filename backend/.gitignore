# ------------------------
# Clojure Project Git Ignore file patterns
# 
# Ignore all except patterns starting with !
# Add comments on separate lines, not same line as pattern
# ------------------------

# ------------------------
# Ignore everthing in root directory
/*

# ------------------------
# Common project files
!CHANGELOG.md
!README.md
!LICENSE

# ------------------------
# Include Clojure project & config
!build.clj
!deps.edn
!pom.xml
!bin/
!dev/
!docs/
!resources/
resources/version.txt
!src/
!test/

# ------------------------
# Include Protobuf source definitions
!proto/

# Exclude downloaded OpenTelemetry protos (run `make otel-proto-download`)
proto/opentelemetry/

# Note: java-src/, classes/, and .bin/ are NOT included (generated, run `dev/setup`)

# ------------------------
# Include Clojure tools
!.cljstyle
!.clj-kondo/
.clj-kondo/.cache/
.clj-kondo/imports/
!.dir-locals.el
!compose.yaml
!Dockerfile
!.dockerignore
!Makefile
!tests.edn

# ------------------------
# Include Git & CI workflow
!.gitattributes
!.gitignore
!.github/

# ------------------------
# Include ClojureScript Figwheel
!figwheel-main.edn
!*.cljs.edn
