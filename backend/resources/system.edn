{:config/core {}

 ;; Owns the root DuckDBConnection and its duplicating-datasource. All three
 ;; pools below duplicate() from it. See o11ylite.components.duckdb-pool.
 :db/duckdb-root
 {:core-config #ig/ref :config/core}

 :db/duckdb-reader
 {:root #ig/ref :db/duckdb-root
  :core-config #ig/ref :config/core}

 ;; Single-writer pools used to serialize all writes to each DuckLake table.
 :db/duckdb-writer-events
 {:root #ig/ref :db/duckdb-root}

 :db/duckdb-writer-metrics
 {:root #ig/ref :db/duckdb-root}

 :db/sqlite
 {:core-config #ig/ref :config/core}

 :storage/init
 {:sqlite #ig/ref :db/sqlite
  :duckdb-writer-events #ig/ref :db/duckdb-writer-events
  :duckdb-writer-metrics #ig/ref :db/duckdb-writer-metrics
  :core-config #ig/ref :config/core}

 :id/generator
 {:core-config #ig/ref :config/core}

 :config/app
 {:core-config #ig/ref :config/core
  :sqlite #ig/ref :db/sqlite
  :_storage #ig/ref :storage/init}

 :cache/blocked-fields
 {:sqlite #ig/ref :db/sqlite
  :_storage #ig/ref :storage/init}

 :discovery/telemetry-catalog-buffer
 {:sqlite #ig/ref :db/sqlite
  :_storage #ig/ref :storage/init}

 :ingest/event-batcher
 {:duckdb #ig/ref :db/duckdb-writer-events
  :telemetry-catalog-buffer #ig/ref :discovery/telemetry-catalog-buffer
  :app-config #ig/ref :config/app
  :_storage #ig/ref :storage/init}

 :ingest/metric-normalizer
 {:app-config #ig/ref :config/app}

 :ingest/metric-batcher
 {:duckdb #ig/ref :db/duckdb-writer-metrics
  :sqlite #ig/ref :db/sqlite
  :normalizer #ig/ref :ingest/metric-normalizer
  :telemetry-catalog-buffer #ig/ref :discovery/telemetry-catalog-buffer
  :app-config #ig/ref :config/app
  :_storage #ig/ref :storage/init}

 :metrics/duckdb
 {:duckdb #ig/ref :db/duckdb-reader}

 :metrics/ducklake
 {:duckdb #ig/ref :db/duckdb-reader
  :_storage #ig/ref :storage/init}

 :scheduler/registry
 {:core-config #ig/ref :config/core
  :duckdb-reader #ig/ref :db/duckdb-reader
  :duckdb-writer-events #ig/ref :db/duckdb-writer-events
  :duckdb-writer-metrics #ig/ref :db/duckdb-writer-metrics
  :sqlite #ig/ref :db/sqlite
  :app-config #ig/ref :config/app
  :_storage #ig/ref :storage/init}

 :scheduler/executor
 {:sqlite #ig/ref :db/sqlite
  :registry #ig/ref :scheduler/registry
  :_storage #ig/ref :storage/init}

 :server/web
 {:core-config #ig/ref :config/core
  :handler #ig/ref :router/routes}

 :auth/config
 {:core-config #ig/ref :config/core
  :sqlite #ig/ref :db/sqlite
  :_storage #ig/ref :storage/init}

 :auth/api-key-cache
 {:sqlite #ig/ref :db/sqlite
  :_storage #ig/ref :storage/init}

 :server/otel-grpc
 {:core-config #ig/ref :config/core
  :duckdb #ig/ref :db/duckdb-reader
  :blocked-fields #ig/ref :cache/blocked-fields
  :event-batcher #ig/ref :ingest/event-batcher
  :id-generator #ig/ref :id/generator
  :metric-batcher #ig/ref :ingest/metric-batcher
  :metric-normalizer #ig/ref :ingest/metric-normalizer
  :sqlite #ig/ref :db/sqlite
  :api-key-cache #ig/ref :auth/api-key-cache}

 :inertia/config
 {:core-config #ig/ref :config/core}

 :router/routes
 {:inertia #ig/ref :inertia/config
  :duckdb-reader #ig/ref :db/duckdb-reader
  :duckdb-writer-events #ig/ref :db/duckdb-writer-events
  :duckdb-writer-metrics #ig/ref :db/duckdb-writer-metrics
  :sqlite #ig/ref :db/sqlite
  :core-config #ig/ref :config/core
  :app-config #ig/ref :config/app
  :blocked-fields #ig/ref :cache/blocked-fields
  :event-batcher #ig/ref :ingest/event-batcher
  :id-generator #ig/ref :id/generator
  :metric-batcher #ig/ref :ingest/metric-batcher
  :metric-normalizer #ig/ref :ingest/metric-normalizer
  :auth-config #ig/ref :auth/config
  :api-key-cache #ig/ref :auth/api-key-cache
  :scheduler-registry #ig/ref :scheduler/registry
  :scheduler-executor #ig/ref :scheduler/executor
  :_storage #ig/ref :storage/init}}
