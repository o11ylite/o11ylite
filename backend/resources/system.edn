{:db/duckdb
 {:data-path #or [#env DATA_PATH "./.tmp"]}

 :db/sqlite
 {:data-path #or [#env DATA_PATH "./.tmp"]}

 :storage/init
 {:sqlite #ig/ref :db/sqlite
  :duckdb #ig/ref :db/duckdb}

 :cache/event-metadata
 {:duckdb #ig/ref :db/duckdb
  ;; _storage is not consumed, but ensures storage/init runs first
  ;; so the events table exists before we DESCRIBE it
  :_storage #ig/ref :storage/init}

 :discovery/services
 {:sqlite #ig/ref :db/sqlite
  :duckdb #ig/ref :db/duckdb
  ;; Scan interval in milliseconds (default: 5 minutes)
  :scan-interval-ms #long #or [#env SERVICE_DISCOVERY_INTERVAL_MS 300000]
  :_storage #ig/ref :storage/init}

 :ingest/batcher
 {:duckdb #ig/ref :db/duckdb
  :event-metadata #ig/ref :cache/event-metadata
  ;; Flush interval in milliseconds (default: 1 second)
  :flush-interval-ms #long #or [#env INGEST_FLUSH_INTERVAL_MS 1000]}

 :server/web
 {:host #or [#env HOST "0.0.0.0"]
  :port #long #or [#env PORT 3000]
  :handler #ig/ref :router/routes}

 :server/otel-grpc
 {:port #long #or [#env OTEL_GRPC_PORT 4317]
  :event-metadata #ig/ref :cache/event-metadata
  :batcher #ig/ref :ingest/batcher}

 :inertia/config
 {;; Dev mode uses Vite dev server, prod reads from manifest
  :dev? #profile {:dev true :default false}

  ;; Base URL for all frontend assets (JS, CSS, favicon)
  ;; Caddy routes this path to Vite (dev) or static files (prod)
  :asset-base-url #or [#env ASSET_BASE_URL "/frontend"]

  ;; Path to Vite's build manifest (relative to resources/)
  ;; Generated by `npm run build` in frontend/
  ;; Contains mapping of entry-point -> hashed output files
  :manifest-path ".vite/manifest.json"

  ;; Entry point file path - must match vite.config.ts rollupOptions.input
  ;; Used as key to look up JS/CSS files in manifest
  :entry-point "src/main.tsx"}

 :router/routes
 {:inertia #ig/ref :inertia/config
  :duckdb #ig/ref :db/duckdb
  :sqlite #ig/ref :db/sqlite
  :event-metadata #ig/ref :cache/event-metadata
  ;; _storage ensures storage/init runs first so DuckDB tables exist
  :_storage #ig/ref :storage/init}}
